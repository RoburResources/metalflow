{
  "name": "Docket Verified \u2014 Email & Audit Log",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"Verified\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "WeightDocket"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "docket_verified_email_audit_log",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onDocketVerified",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onDocketVerified"
  }
}